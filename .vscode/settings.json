{
  // src layout: tell Pylance where the package lives so imports resolve
  // without an editable install.
  "python.analysis.extraPaths": ["src"],
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "terminal.integrated.env.linux": { "PYTHONPATH": "${workspaceFolder}/src" },
  "terminal.integrated.env.osx": { "PYTHONPATH": "${workspaceFolder}/src" },
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}\\src" },
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[markdown]": { "editor.wordWrap": "on", "files.trimTrailingWhitespace": false },
  "files.associations": { "corpus/notes/*.md": "markdown" },
  "search.exclude": { "**/.venv": true, "**/runs": true, "**/.pytest_cache": true }
}
