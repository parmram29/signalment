{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "signalment eval",
      "type": "debugpy",
      "request": "launch",
      "module": "signalment",
      "args": ["eval"],
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "signalment lint",
      "type": "debugpy",
      "request": "launch",
      "module": "signalment",
      "args": ["lint"],
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    }
  ]
}
